{
  "name": "robot-control",
  "displayName": "Robium Robot Control",
  "description": "Reusable movement, mapping, localization, and home controls for ROS 2 robots in Lichtblick.",
  "publisher": "robium",
  "homepage": "https://github.com/robium-ai/robium-apps",
  "version": "0.1.0",
  "license": "MIT",
  "main": "./dist/extension.js",
  "keywords": ["lichtblick", "robotics", "ros2", "navigation"],
  "overrides": {
    "webpack": "5.105.0"
  },
  "scripts": {
    "build": "lichtblick-extension build",
    "lichtblick:prepublish": "lichtblick-extension build --mode production",
    "lint": "eslint --report-unused-disable-directives .",
    "local-install": "lichtblick-extension install",
    "package": "lichtblick-extension package",
    "test": "tsx --test src/*.test.*"
  },
  "devDependencies": {
    "@lichtblick/eslint-plugin": "2.0.8",
    "@lichtblick/suite": "1.8.0",
    "@types/jsdom": "27.0.0",
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "create-lichtblick-extension": "1.1.0",
    "css-loader": "7.1.2",
    "eslint": "9.38.0",
    "globals": "15.14.0",
    "jsdom": "27.0.0",
    "prettier": "3.3.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "style-loader": "4.0.0",
    "tsx": "4.20.6",
    "typescript": "5.7.2"
  }
}

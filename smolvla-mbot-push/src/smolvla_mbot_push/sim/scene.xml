<!--
  Minimal push arena: a differential-drive robot, a block, a painted goal patch,
  and one fixed overhead camera. Deliberately not a model of any specific mBot -
  it is a rehearsal rig for the data and training pipeline, close enough in
  action semantics that a policy transfers as a starting point rather than from
  scratch.

  The goal is painted on the floor rather than passed as state: the policy sees
  it in the image, so no extra observation channel is needed.
-->
<mujoco model="mbot_push">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.55 0.55 0.55" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
    <!-- Must be at least the offscreen render size requested in Python. -->
    <global offwidth="640" offheight="640"/>
  </visual>

  <asset>
    <material name="white" rgba="0.94 0.94 0.94 1"/>
    <material name="robot" rgba="0.15 0.20 0.30 1"/>
    <material name="wheel" rgba="0.08 0.08 0.08 1"/>
    <material name="block" rgba="0.85 0.13 0.13 1"/>
    <material name="goal" rgba="0.20 0.70 0.35 1"/>
    <material name="wall" rgba="0.55 0.57 0.60 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" diffuse="0.7 0.7 0.7"/>
    <geom name="floor" type="plane" size="1.0 1.0 0.05" material="white"/>

    <!-- Arena walls: a 1.0 x 0.8 m pen, standing in for a floor mat's border or
         a table rim. Without them the robot simply drives out of frame, and
         every episode would need a manual bound. -->
    <geom name="wall_px" type="box" size="0.01 0.42 0.04" pos=" 0.51 0 0.04" material="wall"/>
    <geom name="wall_nx" type="box" size="0.01 0.42 0.04" pos="-0.51 0 0.04" material="wall"/>
    <geom name="wall_py" type="box" size="0.52 0.01 0.04" pos="0  0.41 0.04" material="wall"/>
    <geom name="wall_ny" type="box" size="0.52 0.01 0.04" pos="0 -0.41 0.04" material="wall"/>

    <!-- Painted target. No collision: it is a marking, not an obstacle. -->
    <geom name="goal" type="box" size="0.07 0.07 0.001" pos="0.35 0 0.001"
          material="goal" contype="0" conaffinity="0"/>

    <!-- Static look-at camera framing the whole pen. A tracking camera re-runs
         its smoothing filter on every update_scene(), which makes renders
         depend on call history. -->
    <camera name="overhead" pos="0 0 0.95" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <body name="chassis" pos="-0.30 0 0.035">
      <freejoint name="chassis_free"/>
      <geom name="chassis" type="box" size="0.055 0.045 0.020" material="robot" mass="0.45"/>
      <!-- Flat front plate: a bare chassis corner tends to climb the block. -->
      <geom name="pusher" type="box" size="0.005 0.050 0.020" pos="0.060 0 0"
            material="robot" mass="0.05"/>
      <body name="wheel_left" pos="0 0.050 -0.005">
        <joint name="wheel_left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.030 0.008" euler="90 0 0" material="wheel"
              mass="0.05" friction="1.5 0.01 0.001"/>
      </body>
      <body name="wheel_right" pos="0 -0.050 -0.005">
        <joint name="wheel_right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.030 0.008" euler="90 0 0" material="wheel"
              mass="0.05" friction="1.5 0.01 0.001"/>
      </body>
      <!-- Rear skid. Low friction so it slides instead of steering the robot. -->
      <geom name="caster" type="sphere" size="0.012" pos="-0.050 0 -0.023"
            material="wheel" mass="0.02" friction="0.02 0.005 0.0001"/>
    </body>

    <body name="block" pos="0.05 0 0.030">
      <freejoint name="block_free"/>
      <geom name="block" type="box" size="0.030 0.030 0.030" material="block"
            mass="0.08" friction="0.4 0.005 0.0001"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="wheel_left" joint="wheel_left" kv="0.08"
              ctrlrange="-20 20" forcerange="-0.6 0.6"/>
    <velocity name="wheel_right" joint="wheel_right" kv="0.08"
              ctrlrange="-20 20" forcerange="-0.6 0.6"/>
  </actuator>
</mujoco>

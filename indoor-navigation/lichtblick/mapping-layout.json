{
  "configById": {
    "3D!dash": {
      "cameraState": {
        "perspective": false,
        "distance": 14,
        "targetOffset": [0, 0, 0],
        "thetaOffset": 0,
        "phi": 60,
        "fovy": 45,
        "near": 0.5,
        "far": 5000
      },
      "followMode": "follow-pose",
      "followTf": "map",
      "scene": {
        "transforms": {
          "showLabel": false
        }
      },
      "transforms": {},
      "topics": {
        "/map": {
          "visible": true,
          "colorMode": "map"
        },
        "/scan": {
          "visible": true,
          "colorField": "intensity",
          "colorMode": "flat",
          "flatColor": "#e04040",
          "pointSize": 2
        },
        "/plan": {
          "visible": true,
          "lineWidth": 0.12,
          "gradient": ["#00c8ff", "#00c8ff"]
        },
        "/local_plan": {
          "visible": true,
          "lineWidth": 0.08,
          "gradient": ["#ff9f1c", "#ff9f1c"]
        },
        "/plan_smoothed": {
          "visible": false
        },
        "/received_global_plan": {
          "visible": false
        },
        "/transformed_global_plan": {
          "visible": false
        },
        "/global_costmap/costmap": {
          "visible": false,
          "colorMode": "costmap",
          "alpha": 0.35
        },
        "/local_costmap/costmap": {
          "visible": false
        },
        "/robot_description": {
          "visible": true
        }
      },
      "publish": {
        "type": "pose",
        "poseTopic": "/goal_pose",
        "pointTopic": "/clicked_point",
        "poseEstimateTopic": "/initialpose",
        "poseEstimateXDeviation": 0.5,
        "poseEstimateYDeviation": 0.5,
        "poseEstimateThetaDeviation": 0.26
      }
    },
    "Image!robotcam": {
      "imageMode": {
        "imageTopic": "/camera/image_raw"
      }
    },
    "Tab!logs": {
      "activeTabIdx": 0,
      "tabs": [
        {
          "title": "All",
          "layout": "RosOut!logs-all"
        },
        {
          "title": "Navigation",
          "layout": "RosOut!logs-navigation"
        },
        {
          "title": "Mapping & App",
          "layout": "RosOut!logs-mapping-app"
        }
      ]
    },
    "RosOut!logs-all": {
      "topicToRender": "/rosout",
      "searchTerms": [],
      "minLogLevel": 2
    },
    "RosOut!logs-navigation": {
      "topicToRender": "/rosout",
      "searchTerms": [
        "amcl",
        "map_server",
        "controller_server",
        "smoother_server",
        "planner_server",
        "behavior_server",
        "bt_navigator",
        "waypoint_follower",
        "velocity_smoother",
        "collision_monitor",
        "lifecycle_manager_navigation"
      ],
      "minLogLevel": 2
    },
    "RosOut!logs-mapping-app": {
      "topicToRender": "/rosout",
      "searchTerms": [
        "slam_toolbox",
        "session_manager",
        "teleop_relay"
      ],
      "minLogLevel": 2
    },
    "Robium Robot Control.robot-control!control": {
      "version": 3,
      "teleopTopic": "/cmd_vel_teleop",
      "mappingStateTopic": "/mapping/state",
      "availableMapsTopic": "/maps/available",
      "simulationStateTopic": "/simulation/state",
      "availableWaypointsTopic": "/waypoints/available",
      "navigationStateTopic": "/navigation/state",
      "mapNameParameter": "/session_manager.map_name",
      "worldParameter": "/session_manager.world",
      "waypointNameParameter": "/session_manager.waypoint_name",
      "startMappingService": "/mapping/start",
      "stopMappingService": "/mapping/stop",
      "loadMapService": "/mapping/load",
      "restartSimulationService": "/simulation/restart",
      "saveWaypointService": "/waypoints/save",
      "navigateWaypointService": "/waypoints/navigate",
      "deleteWaypointService": "/waypoints/delete",
      "navigationStopService": "/navigation/stop",
      "linearSpeed": 0.2,
      "angularSpeed": 0.8,
      "publishRateHz": 10
    }
  },
  "globalVariables": {},
  "userNodes": {},
  "playbackConfig": { "speed": 1 },
  "layout": {
    "direction": "row",
    "first": {
      "direction": "column",
      "first": {
        "direction": "row",
        "first": "Image!robotcam",
        "second": "3D!dash",
        "splitPercentage": 36
      },
      "second": "Tab!logs",
      "splitPercentage": 72
    },
    "second": "Robium Robot Control.robot-control!control",
    "splitPercentage": 76
  }
}

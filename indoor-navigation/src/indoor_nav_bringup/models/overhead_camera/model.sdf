<?xml version="1.0"?>
<!--
  Static overhead camera for the turtlebot3_house floor plan.

  Rendering is software-only in this container (no GPU), so every camera costs
  real CPU and eats into the sim's real-time factor. Kept deliberately cheap:
  640x480 at 10 Hz is enough to watch the robot drive, and the house is static
  so there is nothing to gain from a higher rate.

  Pose: 18 m up, pitched 90 deg so the camera's +X view axis points at the
  ground. horizontal_fov 0.84 (48 deg) at that height covers 2*18*tan(0.42) =
  16.1 m across and 12.1 m vertically, framing the whole 15 x 10.6 m house
  (which is centred on the origin) with margin. The house has no ceiling, so
  a top-down view sees straight into every room.

  Height and FOV were traded against each other rather than picked freely:
  ground coverage alone fixes how many pixels the robot occupies (~6 px at
  640 wide), so raising the camera and narrowing the FOV costs nothing in
  render time and buys back perspective. At 6 m / 60 deg the frame would show
  a 6.9 m patch — right for the old arena, a corner of the house. At 18 m the
  worst-case view angle at the frame edge is ~24 deg, so a 2.5 m wall occludes
  ~1.1 m of floor behind it instead of the ~1.4 m a lower, wider camera would
  hide. Resolution and rate are deliberately UNCHANGED from the arena setup so
  that real-time factor stays comparable across the world swap.
-->
<sdf version="1.9">
  <model name="overhead_camera">
    <static>true</static>
    <link name="link">
      <pose>0 0 18 0 1.5708 0</pose>
      <sensor name="overhead_camera" type="camera">
        <update_rate>10</update_rate>
        <topic>overhead/image_raw</topic>
        <gz_frame_id>overhead_camera_link</gz_frame_id>
        <camera name="overhead">
          <horizontal_fov>0.84</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>

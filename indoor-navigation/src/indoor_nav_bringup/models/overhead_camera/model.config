<?xml version="1.0"?>
<model>
  <name>overhead_camera</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Static downward-looking camera above the turtlebot3_world arena. Renders the
    whole arena so the viewer can show the robot in context alongside the map.
  </description>
</model>

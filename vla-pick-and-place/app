#!/bin/sh
# Local launcher, matching robot-navigation's ./app verb surface.
#
# This app is uv-native, not Docker-native: the simulator, the dataset
# playback, and the demo UI all run directly on the host. So these verbs wrap
# `make`/`uv` rather than `docker compose`, and `./app run` is a foreground
# process on :8765, not a detached stack — which is why there is no
# `status`/`logs` pair here. `./app stop` exists only to clear a port left
# held by a crashed run.
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$APP_DIR"

# MuJoCo's GL backend is not optional and not auto-detected: CGL on macOS,
# EGL on Linux. Getting it wrong is a hang or a blank render, not an error.
if [ -z "${MUJOCO_GL:-}" ]; then
  if [ "$(uname)" = "Darwin" ]; then MUJOCO_GL=cgl; else MUJOCO_GL=egl; fi
  export MUJOCO_GL
fi

PORT=8765

show_help() {
  cat <<'EOF'
VLA Pick and Place — SO-101 on the published SO101-Nexus MuJoCo environment

Command                  Description
./app help               Show commands and examples
./app doctor             Diagnose prerequisites and conflicts
./app build              Install dependencies
./app run                Build if needed, then serve the workspace on :8765
./app contract           Print what the pinned environment actually is
./app dataset-check      Verify the pinned demonstrations match this environment
./app controllers        List controllers and why unavailable ones cannot run
./app expert [N]         Measure the scripted expert's success rate
./app record [N]         Record N successful expert demonstrations
./app sim [SEED] [N]     Drive the simulator headless, write an .rrd
./app play [EPISODE]     Replay a recorded demonstration headless, write an .rrd
./app test               Run the regression suite
./app stop               Free port 8765 if a crashed run still holds it

Examples:
  ./app sim 3 60         # seed 3, 60 control steps -> outputs/viz/sim_seed3.rrd
  ./app play 2           # recorded episode 2      -> outputs/viz/episode_2.rrd

There is no trained controller yet — './app controllers' says why, and
docs/training-guide.md is the path to one.
EOF
}

port_holder() {
  command -v lsof >/dev/null 2>&1 || return 0
  lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null || true
}

doctor() {
  ok=1

  if command -v uv >/dev/null 2>&1; then
    echo "ok: uv present"
  else
    echo "FAIL: uv not installed (https://docs.astral.sh/uv/)"
    ok=0
  fi

  [ -f uv.lock ] || { echo "FAIL: uv.lock missing (broken checkout)"; ok=0; }

  if [ -d .venv ]; then
    echo "ok: .venv present"
  else
    echo "note: no .venv yet — './app build' will create it"
  fi

  echo "ok: MUJOCO_GL=$MUJOCO_GL"

  holder=$(port_holder)
  if [ -n "$holder" ]; then
    echo "FAIL: port $PORT already in use (pid $holder) — './app stop' or quit it"
    ok=0
  else
    echo "ok: port $PORT available"
  fi

  # Both the environment (a pip package) and the demonstrations (a public Hub
  # dataset) are public, so nothing here needs Hugging Face auth. Reaching the
  # Hub at all is still required for the FIRST dataset playback; after that it
  # is cached. Report reachability, not credentials.
  if [ -d .venv ]; then
    if .venv/bin/python -c "import so101_nexus" >/dev/null 2>&1; then
      echo "ok: so101-nexus installed ($(.venv/bin/python -c 'import so101_nexus;print(so101_nexus.__version__)'))"
    else
      echo "note: so101-nexus not installed yet — './app build' installs it"
    fi
  fi

  if [ "$ok" -eq 1 ]; then
    echo "DOCTOR PASS"
  else
    echo "DOCTOR FAIL"
    return 1
  fi
}

build() {
  make sync
}

run() {
  [ -d .venv ] || {
    echo "First run — installing dependencies..."
    build
  }
  echo "workspace -> http://localhost:$PORT/ui"
  make demo
}

stop() {
  holder=$(port_holder)
  if [ -z "$holder" ]; then
    echo "nothing listening on :$PORT"
    return 0
  fi
  echo "killing pid $holder holding :$PORT"
  kill "$holder"
}

command=${1:-help}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  help|-h|--help) show_help ;;
  doctor) doctor ;;
  build) build ;;
  run) run ;;
  test) make test ;;
  stop) stop ;;
  contract) make contract ;;
  dataset-check) make dataset-check ;;
  controllers) make controllers ;;
  expert) make expert N="${1:-30}" ;;
  record) make record EPISODES="${1:-50}" ;;
  sim) make sim SEED="${1:-0}" STEPS="${2:-60}" ;;
  play) make play EPISODE="${1:-0}" ;;
  *)
    echo "Unknown command: $command" >&2
    echo "Run './app help' to see available commands." >&2
    exit 2
    ;;
esac

#!/bin/sh
set -eu

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$APP_DIR"

show_help() {
  printf '%s\n' \
    "Pi0.5 · LIBERO-Goal task 8" \
    "" \
    "./app doctor       Check the free local runtime" \
    "./app build        Install the pinned base environment" \
    "./app test         Run free unit and integration tests" \
    "./app smoke        Run one deterministic fake rollout" \
    "./app run          Serve the local fake Gradio gateway" \
    "./app image-fake   Build the Linux/amd64 CPU smoke image" \
    "./app image-gpu    Build the pinned Linux/amd64 CUDA image"
}

command=${1:-help}
case "$command" in
  help|-h|--help) show_help ;;
  doctor) make doctor ;;
  build) make sync ;;
  test) make test ;;
  smoke) make smoke ;;
  run) make run ;;
  image-fake) make image-fake ;;
  image-gpu) make image-gpu ;;
  *)
    printf 'Unknown command: %s\n' "$command" >&2
    show_help >&2
    exit 2
    ;;
esac

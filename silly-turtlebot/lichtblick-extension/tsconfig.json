{
  "extends": "create-lichtblick-extension/tsconfig/tsconfig.json",
  "include": ["./src/**/*"],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["dom", "es2023"],
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}

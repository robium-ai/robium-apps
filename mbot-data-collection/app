#!/usr/bin/env bash
# Repository-local command surface. See robium-app.yaml for the contract.
set -euo pipefail
cd "$(dirname "$0")"

# OpenCV and pygame each vendor their own SDL2, and macOS warns once per
# duplicated Objective-C class when both load. It is unavoidable here (we need
# OpenCV to capture and pygame to draw) and harmless, because headless OpenCV
# never opens a window - but seventeen lines of it buries real errors. Filter
# exactly that chatter and nothing else.
NOISE='^objc\[[0-9]+\]: Class SDL|^objc\[[0-9]+\]: Class Cocoa_|^objc\[[0-9]+\]: Class METAL_|^OpenCV: |Failed list devices for backend|^pygame [0-9]|^Hello from the pygame community'
exec 2> >(grep -Ev "$NOISE" >&2)

case "${1:-help}" in
  help|-h|--help)
    cat <<'USAGE'
mbot-data-collection - drive a real mBot and record episodes for VLA training

  ./app build       create the uv environment
  ./app build-record  ... and add LeRobot, needed only for recording
  ./app doctor      check port, firmware, camera and gamepad
  ./app flash       compile and upload the bridge firmware to the mBot
  ./app ping        talk to the firmware and beep
  ./app cameras     list cameras with their names
  ./app gamepad     show live gamepad axis values
  ./app calibrate   learn which motor is which, and which way it turns
  ./app calibrate --floor   measure the lowest duty that moves the wheels
  ./app drive       drive with the arrow keys or a gamepad
  ./app record      record teleoperated episodes into a dataset
  ./app push        upload a recorded dataset to the Hub
  ./app config      show the saved calibration
  ./app smoke       check the robot, camera and controller

First run:
  ./app build && ./app flash && ./app doctor
  ./app calibrate
  ./app drive
USAGE
    ;;
  build) uv sync ;;
  build-record) uv sync --extra record ;;
  smoke) make smoke ;;
  doctor|flash|ping|cameras|gamepad|calibrate|drive|record|push|config)
    cmd="$1"; shift; uv run python -m mbot_data_collection.run "$cmd" "$@" ;;
  *)
    echo "Unknown command: $1" >&2
    echo "Run './app help' for usage." >&2
    exit 1 ;;
esac
